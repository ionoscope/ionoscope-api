    "/api/v1/forecast/status/{station}": {
      "get": {
        "tags": [
          "forecast"
        ],
        "summary": "Forecast Status",
        "operationId": "forecast_status",
        "parameters": [
          {
            "name": "station",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[A-Za-z0-9_-]+$",
              "title": "Station"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
