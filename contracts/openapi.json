  "components": {
    "schemas": {
      "Column": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "unit"
        ],
        "title": "Column"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_station",
              "station_not_found",
              "parameter_unavailable",
              "forecast_unavailable",
              "insufficient_observations",
              "forecast_expired",
              "explanation_unavailable",
              "upstream_error",
              "upstream_timeout",
              "invalid_request",
              "station_inactive",
              "cache_unavailable",
              "not_found",
              "request_error",
              "internal_error",
              "rate_limited"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "examples": [
          {
            "detail": {
              "code": "forecast_unavailable",
              "message": "Forecast is unavailable"
            }
          }
        ]
      },
      "ExplainRequest": {
        "properties": {
          "forecast_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Z0-9_-]+_[0-9a-f]{32}$",
            "title": "Forecast Id"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "geodesist"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "forecast_id"
        ],
        "title": "ExplainRequest",
        "examples": [
          {
            "forecast_id": "TR169_0123456789abcdef0123456789abcdef",
            "role": "geodesist"
          }
        ]
      },
      "ForecastPoint": {
        "properties": {
          "t_start": {
            "type": "string",
            "format": "date-time",
            "title": "T Start"
          },
          "t_end": {
            "type": "string",
            "format": "date-time",
            "title": "T End"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "lower": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lower"
          },
          "upper": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper"
          }
        },
        "type": "object",
        "required": [
          "t_start",
          "t_end",
          "value",
          "lower",
          "upper"
        ],
        "title": "ForecastPoint"
      },
      "ForecastRequest": {
        "properties": {
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "geodesist"
          },
          "parameter": {
            "type": "string",
            "title": "Parameter",
            "default": "foF2"
          },
          "station": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^[A-Z0-9_-]+$",
            "title": "Station"
          }
        },
        "type": "object",
        "required": [
          "station"
        ],
        "title": "ForecastRequest",
        "examples": [
          {
            "station": "TR169",
            "parameter": "foF2",
            "role": "geodesist"
          }
        ]
      },
      "ForecastResponse": {
        "properties": {
          "forecast_id": {
            "type": "string",
            "title": "Forecast Id",
            "default": ""
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "default": "geodesist"
          },
          "series": {
            "$ref": "#/components/schemas/Series"
          },
          "table": {
            "$ref": "#/components/schemas/Table"
          },
          "stale_after": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stale After"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "station": {
            "type": "string",
            "title": "Station"
          },
          "source_timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Source Timestamp"
          },
          "source_interval_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Interval End"
          },
          "forecast_interval_start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Interval Start"
          },
          "observation_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Timestamp"
          },
          "current_fof2_available": {
            "type": "boolean",
            "title": "Current Fof2 Available",
            "default": false
          },
          "forecast_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Timestamp"
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Generated At"
          },
          "parameter": {
            "type": "string",
            "title": "Parameter"
          },
          "prediction": {
            "type": "number",
            "title": "Prediction"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "horizon": {
            "type": "string",
            "title": "Horizon"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "cached": {
            "type": "boolean",
            "title": "Cached",
            "default": false
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "freshness_status": {
            "type": "string",
